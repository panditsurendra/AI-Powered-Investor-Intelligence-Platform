@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

:root {
    --bg-main: #0f172a;
    --bg-panel: #1e293b;
    --bg-card: #334155;
    --bg-hover: #475569;
    
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    
    --accent-blue: #3b82f6;
    --accent-blue-hover: #2563eb;
    --accent-green: #10b981;
    --accent-amber: #f59e0b;
    --accent-purple: #8b5cf6;
    --accent-red: #ef4444;
    
    --border-light: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(255, 255, 255, 0.15);
    
    --shadow-sm: 0 1px 2px rgba(0,0,0,0.2);
    --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.3);
    --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.4);
    
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-main);
    color: var(--text-primary);
    overflow-x: hidden;
}

/* Dashboard Layout */
.dashboard-wrapper {
    display: grid;
    grid-template-columns: 280px 1fr 360px;
    height: 100vh;
    overflow: hidden;
    transition: all 0.3s ease;
}

.dashboard-wrapper.chat-collapsed {
    grid-template-columns: 280px 1fr 0px;
}

/* Sidebar */
.sidebar {
    background-color: var(--bg-panel);
    border-right: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    padding: 24px;
    gap: 24px;
    overflow-y: auto;
}

.logo-section {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border-light);
}

.logo-icon {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
}

.logo-icon svg {
    width: 20px;
    height: 20px;
}

.logo-text {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.5px;
    background: linear-gradient(to right, #fff, #94a3b8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

/* Uploader Card */
.uploader-card {
    background: rgba(255, 255, 255, 0.03);
    border: 2px dashed var(--border-strong);
    border-radius: var(--radius-md);
    padding: 24px 16px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
}

.uploader-card:hover, .uploader-card.dragover {
    background: rgba(59, 130, 246, 0.1);
    border-color: var(--accent-blue);
}

.uploader-icon {
    color: var(--accent-blue);
    margin-bottom: 12px;
}

.uploader-icon svg {
    width: 32px;
    height: 32px;
}

.uploader-title {
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 4px;
}

.uploader-desc {
    font-size: 12px;
    color: var(--text-secondary);
}

.file-input {
    display: none;
}

/* Progress Bar */
.progress-container {
    display: none;
    background: var(--bg-card);
    padding: 16px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
}

.progress-header {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    margin-bottom: 8px;
    color: var(--text-secondary);
}

.progress-bar-bg {
    height: 6px;
    background: var(--bg-main);
    border-radius: 4px;
    overflow: hidden;
}

.progress-bar-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--accent-blue), var(--accent-purple));
    transition: width 0.3s ease;
}

/* YT Card */
.yt-card {
    background: linear-gradient(145deg, #1e293b, #0f172a);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 16px;
    margin-top: auto;
}

.yt-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
}

.yt-icon {
    color: #ff0000;
    width: 28px;
    height: 28px;
}

.yt-meta {
    display: flex;
    flex-direction: column;
}

.yt-channel-name {
    font-weight: 600;
    font-size: 14px;
}

.yt-badge {
    font-size: 11px;
    color: var(--text-muted);
}

.yt-body p {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.4;
    margin-bottom: 12px;
}

.yt-actions {
    display: flex;
    gap: 8px;
}

.yt-action-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    background: var(--bg-card);
    cursor: pointer;
    transition: all 0.2s;
}

.yt-action-item:hover {
    background: var(--bg-hover);
}

.yt-action-item.active {
    background: rgba(239, 68, 68, 0.1);
    color: var(--accent-red);
}

.yt-action-icon {
    width: 16px;
    height: 16px;
}

/* Stats Summary */
.stats-summary {
    background: var(--bg-card);
    border-radius: var(--radius-md);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.stat-label {
    font-size: 13px;
    color: var(--text-secondary);
}

.stat-val {
    font-weight: 600;
    background: rgba(255, 255, 255, 0.1);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 12px;
}

/* Main Content */
.main-content {
    overflow-y: auto;
    padding: 32px 40px;
    display: flex;
    flex-direction: column;
    gap: 32px;
}

.header-container h1 {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 8px;
}

.header-container p {
    color: var(--text-secondary);
}

/* KPI Grid */
.kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
}

.kpi-card {
    background: var(--bg-panel);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: rgba(255,255,255,0.2);
}

.kpi-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}

.kpi-info h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 4px;
}

.kpi-info p {
    font-size: 12px;
    color: var(--text-secondary);
}

.kpi-icon-wrapper {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
}

.kpi-icon-wrapper svg {
    width: 20px;
    height: 20px;
}

.kpi-values-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.kpi-value-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.kpi-company-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
}

.company-badge-name {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
}

.company-logo-avatar {
    background: var(--bg-hover);
    color: var(--text-primary);
    font-size: 10px;
    font-weight: 600;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
}

.kpi-val-number {
    font-weight: 600;
    font-family: monospace;
    font-size: 14px;
}

.kpi-compare-bar-bg {
    height: 4px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 2px;
    overflow: hidden;
}

.kpi-compare-bar-fill {
    height: 100%;
    border-radius: 2px;
}

/* Deep Dive Section */
.deep-dive-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-light);
}

.section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    font-weight: 600;
}

.section-title svg {
    width: 24px;
    height: 24px;
    color: var(--accent-blue);
}

.deep-dive-card {
    background: var(--bg-panel);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 24px;
}

.inspector-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
}

.inspector-meta h2 {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 4px;
}

.inspector-meta p {
    font-size: 13px;
    color: var(--text-secondary);
}

.company-selector-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
}

.company-selector-wrapper label {
    font-size: 13px;
    color: var(--text-secondary);
}

.company-select, .chat-context-select {
    background: var(--bg-main);
    border: 1px solid var(--border-strong);
    color: var(--text-primary);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    outline: none;
    cursor: pointer;
}

.company-select:focus, .chat-context-select:focus {
    border-color: var(--accent-blue);
}

.qualitative-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
}

.qualitative-column {
    background: rgba(0, 0, 0, 0.15);
    border-radius: var(--radius-md);
    padding: 20px;
}

.qual-col-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 16px;
}

.drivers-title { color: var(--accent-green); }
.risks-title { color: var(--accent-amber); }

.qual-col-title svg {
    width: 18px;
    height: 18px;
}

.qual-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.qual-item {
    display: flex;
    gap: 12px;
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
    background: rgba(255, 255, 255, 0.03);
    padding: 12px;
    border-radius: var(--radius-sm);
    border-left: 2px solid transparent;
}

.qual-item:hover {
    background: rgba(255, 255, 255, 0.05);
}

.driver-item-icon { color: var(--accent-green); }
.risk-item-icon { color: var(--accent-amber); }

.qual-item-icon svg {
    width: 16px;
    height: 16px;
    margin-top: 2px;
}

.no-qualitative {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px 0;
    color: var(--text-muted);
    font-size: 13px;
    gap: 12px;
}

.no-qualitative svg {
    width: 32px;
    height: 32px;
    opacity: 0.5;
}

/* Chat Panel */
.chat-panel {
    background: var(--bg-panel);
    border-left: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
}

.chat-panel.collapsed {
    transform: translateX(100%);
    opacity: 0;
}

.chat-panel-header {
    padding: 20px;
    border-bottom: 1px solid var(--border-light);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.chat-panel-title {
    display: flex;
    align-items: center;
    gap: 12px;
}

.chat-panel-icon {
    width: 32px;
    height: 32px;
    background: rgba(139, 92, 246, 0.15);
    color: var(--accent-purple);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.chat-panel-icon svg {
    width: 18px;
    height: 18px;
}

.chat-header-text {
    display: block;
    font-weight: 600;
    font-size: 15px;
}

.chat-header-sub {
    display: block;
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 2px;
}

.chat-panel-toggle {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
}

.chat-panel-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
}

.chat-panel-toggle svg {
    width: 20px;
    height: 20px;
}

.chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.chat-msg {
    display: flex;
    gap: 12px;
    max-width: 90%;
}

.user-msg {
    align-self: flex-end;
    flex-direction: row-reverse;
}

.bot-msg {
    align-self: flex-start;
}

.chat-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.bot-avatar {
    background: linear-gradient(135deg, var(--accent-purple), var(--accent-blue));
    color: white;
}

.user-avatar {
    background: var(--bg-hover);
    color: var(--text-primary);
}

.chat-avatar svg {
    width: 16px;
    height: 16px;
}

.chat-bubble {
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.5;
}

.bot-bubble {
    background: var(--bg-card);
    border-top-left-radius: 4px;
    color: var(--text-primary);
}

.user-bubble {
    background: var(--accent-blue);
    border-top-right-radius: 4px;
    color: white;
}

.chat-input-area {
    padding: 20px;
    border-top: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.chat-context-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(0,0,0,0.2);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
}

.chat-context-label {
    font-size: 11px;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--text-muted);
}

.chat-context-select {
    border: none;
    background: transparent;
    padding: 0;
    font-size: 12px;
    color: var(--accent-blue);
    font-weight: 500;
}

.chat-input-row {
    display: flex;
    gap: 8px;
    background: var(--bg-main);
    border: 1px solid var(--border-strong);
    border-radius: 24px;
    padding: 6px 6px 6px 16px;
    align-items: center;
}

.chat-input-row:focus-within {
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
}

.chat-text-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-size: 13px;
    outline: none;
}

.chat-text-input::placeholder {
    color: var(--text-muted);
}

.chat-send-btn {
    background: var(--accent-blue);
    color: white;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
}

.chat-send-btn:hover {
    background: var(--accent-blue-hover);
}

.chat-send-btn svg {
    width: 16px;
    height: 16px;
}

/* Typing Indicator */
.typing-dots {
    display: flex;
    gap: 4px;
    align-items: center;
    height: 10px;
}

.typing-dots span {
    width: 4px;
    height: 4px;
    background: var(--text-secondary);
    border-radius: 50%;
    animation: typing 1.4s infinite ease-in-out both;
}

.typing-dots span:nth-child(1) { animation-delay: -0.32s; }
.typing-dots span:nth-child(2) { animation-delay: -0.16s; }

@keyframes typing {
    0%, 80%, 100% { transform: scale(0); }
    40% { transform: scale(1); }
}

/* Collapsed Chat Tab */
.chat-collapsed-tab {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%) translateX(100%);
    background: var(--bg-panel);
    border: 1px solid var(--border-strong);
    border-right: none;
    padding: 12px;
    border-radius: 8px 0 0 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    box-shadow: var(--shadow-md);
    transition: all 0.3s ease;
    opacity: 0;
}

.chat-collapsed-tab.visible {
    transform: translateY(-50%) translateX(0);
    opacity: 1;
}

.chat-collapsed-tab:hover {
    background: var(--bg-hover);
}

.chat-collapsed-tab svg {
    width: 20px;
    height: 20px;
    color: var(--accent-purple);
}

.chat-collapsed-tab span {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    transform: rotate(180deg);
}

/* Toasts */
.toast-container {
    position: fixed;
    bottom: 24px;
    left: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 1000;
}

.toast {
    background: var(--bg-panel);
    border-left: 4px solid var(--accent-blue);
    padding: 16px;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-width: 300px;
    transform: translateX(-120%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.toast.show {
    transform: translateX(0);
}

.toast-success { border-left-color: var(--accent-green); }
.toast-error { border-left-color: var(--accent-red); }

.toast-icon {
    margin-top: 2px;
}

.toast-success .toast-icon { color: var(--accent-green); }
.toast-error .toast-icon { color: var(--accent-red); }

.toast-icon svg {
    width: 20px;
    height: 20px;
}

.toast-content {
    flex: 1;
}

.toast-title {
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 4px;
}

.toast-message {
    font-size: 13px;
    color: var(--text-secondary);
}

.toast-close {
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
}

.toast-close:hover {
    color: var(--text-primary);
}

.toast-close svg {
    width: 16px;
    height: 16px;
}

/* Responsive */
@media (max-width: 1200px) {
    .dashboard-wrapper {
        grid-template-columns: 240px 1fr;
    }
    .chat-panel {
        position: fixed;
        right: 0;
        top: 0;
        bottom: 0;
        width: 340px;
        z-index: 100;
        transform: translateX(100%);
    }
    .dashboard-wrapper:not(.chat-collapsed) .chat-panel {
        transform: translateX(0);
        box-shadow: -10px 0 20px rgba(0,0,0,0.5);
    }
    .dashboard-wrapper.chat-collapsed {
        grid-template-columns: 240px 1fr;
    }
}